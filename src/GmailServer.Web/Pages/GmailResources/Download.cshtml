@page
@model GmailServer.Web.Pages.GmailResources.DownloadModel
@using GmailServer.Web.Menus
@using Volo.Abp.AspNetCore.Mvc.UI.Layout
@using Microsoft.AspNetCore.Mvc.Localization
@using GmailServer.Localization
@using GmailServer.Permissions
@using Microsoft.AspNetCore.Authorization
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@inject IPageLayout PageLayout
@inject IHtmlLocalizer<GmailServerResource> L
@inject IAuthorizationService AuthorizationService
@{
    ViewBag.PageTitle = L["Download Gmail Resources"];
    PageLayout.Content.Title = L["Download Gmail Resources"].Value;
}

@section scripts {
<script>
    var gmailResourceStatusSelections = @Html.Raw(ViewData["gmailResourceStatusSelections"]);
    var usernameSelections = @Html.Raw(ViewData["usernameSelections"]);
</script>
<abp-script-bundle name="knockout" />
<abp-script-bundle name="chosen" />
<abp-script src="/Pages/GmailResources/js/downloadViewModel.js" />
<script>
    var viewModel = new DownloadViewModel(usernameSelections, gmailResourceStatusSelections);
    ko.applyBindings(viewModel);
</script>
}

@section styles {
<abp-style-bundle name="chosen" />
<style>
    .col-md-6 label {
        margin-left: 5px;
    }

    .lb-checkbox {
        padding: 15px 35px;
        border-radius: 11px;
        background: #f1f1f1;
        width: 335px;
        margin-bottom: 15px;
    }

    .row-bottom {
        margin-top: 15px;
        padding-top: 15px;
        border-top: 2px solid black;
    }

    .row-top {
        margin-top: 15px;
    }

    .created-date {
        display: inline-flex;
    }

    .created-date input {
        margin-left: 15px; 
        width: 345px;
    }
</style>
}

<abp-card>
    <abp-card-header>
        <abp-row>
            <abp-column size-md="_6">
                <h4>Download Gmail Resources</h4>
            </abp-column>
        </abp-row>
    </abp-card-header>
    <form id="downloadGmailForm" action="/GmailResources/Download" method="post" onSubmit="if(!confirm('Are you sure to download?')){return false;}">
        @(Html.AntiForgeryToken())
        <abp-card-body>
            <div class="row">
                <div class="col-md-6">
                    <div class="row row-top">
                        <div class="col-md-2">
                            <label>Username (*)</label>
                        </div>
                        <div class="col-md-9">
                            <select name="Username" class="form-control"
                                    data-bind="options: usernames, optionsText: (i) => i.text, optionsValue: 'value', chosen: {}, value: selectedUsername"></select>
                        </div>
                    </div>
                    <div class="row row-bottom">
                        <div class="col-md-2">
                            <label>Created Date</label>
                        </div>
                        <div class="col-md-9">
                            <div class="created-date">
                                <label style="padding-top: 5px;">From</label>
                                <input id="createdFrom" type="date"
                                       class="form-control"
                                       asp-for="@Model.CreatedFrom"
                                       autocomplete="off"
                                       data-bind="textInput: createdFrom" />
                                <label style="padding: 5px 0px 0px 10px;">To</label>
                                <input id="createdTo" type="date"
                                       class="form-control"
                                       asp-for="@Model.CreatedTo"
                                       autocomplete="off"
                                       data-bind="textInput: createdTo"/>
                            </div>
                        </div>
                    </div>
                    <div class="row row-top">
                        <div class="col-md-2">
                            <label>Status</label>
                        </div>
                        <div class="col-md-10">
                            <div class="row" data-bind="foreach: { data: statuses, as: 'status' }">
                                <div class="col-md-6">
                                    <label class="lb-checkbox">
                                        <input type="checkbox" name="Statuses" data-bind="value: status.value" style="transform: scale(1.8);" />
                                        <span data-bind="text: status.text" style="font-size: 20px; margin-left: 15px;"></span>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row row-bottom">
                        <div class="col-md-2">
                            <label>File name (*)</label>
                        </div>
                        <div class="col-md-9">
                            <input type="text" asp-for="FileName" class="form-control" />
                        </div>
                    </div>
                </div>
            </div>
        </abp-card-body>
        <abp-modal-footer buttons="@(AbpModalButtons.Cancel|AbpModalButtons.Save)"></abp-modal-footer>
    </form>
</abp-card>

