@page
@model GmailServer.Web.Pages.GmailResources.IndexModel
@using GmailServer.Web.Menus
@using Volo.Abp.AspNetCore.Mvc.UI.Layout
@using Microsoft.AspNetCore.Mvc.Localization
@using GmailServer.Localization
@using GmailServer.Permissions
@using Microsoft.AspNetCore.Authorization
@inject IPageLayout PageLayout
@inject IHtmlLocalizer<GmailServerResource> L
@inject IAuthorizationService AuthorizationService
@{
    ViewBag.PageTitle = L["Gmail Resource"];
    PageLayout.Content.Title = L["Gmail Resource"].Value;
    PageLayout.Content.MenuItemName = GmailServerMenus.GmailResource;
}

@section scripts {
     <script>
        var gmailResourceStatusSelections = @Html.Raw(ViewData["gmailResourceStatusSelections"]);
    </script>
    <abp-script src="/Pages/GmailResources/js/index.js"/>
}
@section styles {
<style>
    .modal-dialog {
        max-width: 800px;
    }
    .text-ellipsis {
        overflow: hidden;
        white-space: nowrap;
        display: inline-block;
        text-overflow: ellipsis;
        width: 300px;
    }
</style>
}

<abp-card>
    <abp-card-header>
        <abp-row>
            <abp-column size-md="_6">
                <h4>Gmail Resource</h4>
            </abp-column>
            <abp-column size-md="_6">
                @if (await AuthorizationService.IsGrantedAsync(GmailServerPermissions.GmailResources.Create))
                {
                    <abp-button class="float-right btn btn-small btn-primary" id="createBtn" icon="plus" text="Create"></abp-button>
                }
                @if (await AuthorizationService.IsGrantedAsync(GmailServerPermissions.GmailResources.Delete))
                {
                    <abp-button class="float-right btn btn-small btn-primary" id="btnRemoveAll" icon="trash" text="Remove All" style="margin-right: 15px;"></abp-button>
                }
            </abp-column>
        </abp-row>
    </abp-card-header>
    <abp-card-body>
        <abp-table striped-rows="true" id="gmailResourceTable" class="table-bordered">
            <thead> 
                <tr>
                    <th>@L["ID"]</th>
                    <th>@L["Username"]</th>
                    <th>@L["Email"]</th>
                    <th>@L["Password"]</th>
                    <th>@L["Recovery Email"]</th>
                    <th>@L["Status"]</th>
                    <th>@L["Taken Time"]</th>
                    <th>@L["Created"]</th>
                    <th>@L["Updated"]</th>
                    <th>@L["Action"]</th>
                </tr>
            </thead>
        </abp-table>
    </abp-card-body>
</abp-card>
