@page
@model GmailServer.Web.Pages.GmailResources.IndexModel
@using GmailServer.Web.Menus
@using Volo.Abp.AspNetCore.Mvc.UI.Layout
@using Microsoft.AspNetCore.Mvc.Localization
@using GmailServer.Localization
@using GmailServer.Permissions
@using Microsoft.AspNetCore.Authorization
@inject IPageLayout PageLayout
@inject IHtmlLocalizer<GmailServerResource> L
@inject IAuthorizationService AuthorizationService
@{
    ViewBag.PageTitle = L["Gmail Resource"];
    PageLayout.Content.Title = L["Gmail Resource"].Value;
    PageLayout.Content.MenuItemName = GmailServerMenus.GmailResource;
}

@section scripts {
    <abp-script-bundle name="knockout" />
    <abp-script-bundle name="chosen" />
    <script>
        var usernameSelections = @Html.Raw(ViewData["usernameSelections"]);
        var gmailResourceStatusSelections = @Html.Raw(ViewData["gmailResourceStatusSelections"]);
        var premiumTypeSelections = @Html.Raw(ViewData["premiumTypeSelections"]);
        var isRoleNameAppleIdMember = @Html.Raw(ViewData["isRoleNameAppleIdMember"]);
    </script>
    <abp-script src="/Pages/GmailResources/js/index.js" />
    <abp-script src="/Pages/GmailResources/js/resetStatusViewModel.js" />
    @*<abp-script src="/Pages/GmailResources/js/downloadViewModel.js" />*@
}
@section styles {
    <abp-style-bundle name="chosen" />
    <style>
        .modal-dialog {
            max-width: 800px;
        }

        .text-ellipsis {
            overflow: hidden;
            white-space: nowrap;
            display: inline-block;
            text-overflow: ellipsis;
            width: 300px;
        }

        .float-right.btn.btn-small {
            margin-right: 15px;
        }
    </style>
}

<abp-card>
    <abp-card-header>
        <abp-row>
            <abp-column size-md="_6">
                <h4>Gmail Resource</h4>
            </abp-column>
            <abp-column size-md="_6">
                @if (await AuthorizationService.IsGrantedAsync(GmailServerPermissions.GmailResources.Create))
                {
                    <abp-button class="float-right btn btn-small btn-primary" id="createBtn" icon="plus" text="Create"></abp-button>
                }
                @if (await AuthorizationService.IsGrantedAsync(GmailServerPermissions.GmailResources.ReupEmail))
                {
                    <a class="float-right btn btn-small btn-primary" href="/GmailResources/ReupModal">
                        <i class="fa fa-reply" aria-hidden="true"></i>&nbsp;Re-up Email
                    </a>
                    @*<abp-button class="float-right btn btn-small btn-primary" id="reupBtn" icon="reply" text="Re-up Email"></abp-button>*@
                }
                @*  @if (await AuthorizationService.IsGrantedAsync(GmailServerPermissions.GmailResources.Download))
                {
                <a class="float-right btn btn-small btn-primary" href="/GmailResources/Download">
                <i class="fa fa-download" aria-hidden="true"></i>&nbsp;Download
                </a>
                }
                @if (await AuthorizationService.IsGrantedAsync(GmailServerPermissions.GmailResources.ResetStatus))
                {
                <a class="float-right btn btn-small btn-danger" href="/GmailResources/ResetStatus">
                <i class="fa fa-refresh" aria-hidden="true"></i>&nbsp;<span>Reset Status</span>
                </a>
                }*@
                @if (await AuthorizationService.IsGrantedAsync(GmailServerPermissions.GmailResources.DeleteAll))
                {
                    <abp-button class="float-right btn btn-small btn-danger" id="btnRemoveAll" icon="trash" text="Remove All"></abp-button>
                }
            </abp-column>
        </abp-row>
    </abp-card-header>
    <abp-card-body>
        <abp-table striped-rows="true" id="gmailResourceTable" class="table-bordered">
            <thead>
                <tr>
                    <th>@L["ID"]</th>
                    <th>@L["Username"]</th>
                    <th>@L["Email"]</th>
                    <th>@L["Password"]</th>
                    <th>@L["Recovery Email"]</th>
                    <th>@L["Country"]</th>
                    <th>@L["Status"]</th>
                    <th>@L["Premium Type"]</th>
                    <th>@L["Updated Premium"]</th>
                    <th>@L["Taken Time"]</th>
                    <th>@L["Created"]</th>
                    <th>@L["Updated"]</th>
                    <th>@L["Action"]</th>
                </tr>
            </thead>
        </abp-table>
    </abp-card-body>
</abp-card>
