@page
@model GmailServer.Web.Pages.AppleOrders.StatisticByAddPaymentStatusModel
@using GmailServer.Web.Menus
@using Volo.Abp.AspNetCore.Mvc.UI.Layout
@using Microsoft.AspNetCore.Mvc.Localization
@using GmailServer.Localization
@using GmailServer.Permissions
@using Microsoft.AspNetCore.Authorization
@inject IPageLayout PageLayout
@inject IHtmlLocalizer<GmailServerResource> L
@inject IAuthorizationService AuthorizationService
@{
    ViewBag.PageTitle = L["Apple Order Statistic"];
    PageLayout.Content.Title = L["Apple Order Statistic"].Value;
    PageLayout.Content.MenuItemName = GmailServerMenus.AppleOrderStatistic;
}

@section scripts {
    <abp-script src="/Pages/AppleOrders/js/statisticByAddPaymentStatus.js" />
}
<abp-card>
    <abp-card-header>
        <abp-row>
            <abp-column size-md="_6">
                <h4>Add Payment Status</h4>
            </abp-column>
        </abp-row>
    </abp-card-header>
    <abp-card-body>
        <abp-table striped-rows="true" id="statisticByAddPaymentStatusTable" class="table-bordered">
            <thead>
                <tr>
                    <th>@L["#"]</th>
                    <th>@L["Created"]</th>
                    <th>@L["Total Order"]</th>
                    <th>@L["None"]</th>
                    <th>@L["InUse"]</th>
                    <th>@L["Expired"]</th>
                    <th>@L["Error"]</th>
                    <th>@L["Completed"]</th>
                </tr>
            </thead>
        </abp-table>
    </abp-card-body>
</abp-card>