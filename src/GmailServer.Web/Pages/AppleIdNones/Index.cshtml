@page
@model GmailServer.Web.Pages.AppleIdNones.IndexModel
@using GmailServer
@using GmailServer.Web.Menus
@using Volo.Abp.AspNetCore.Mvc.UI.Layout
@using Microsoft.AspNetCore.Mvc.Localization
@using GmailServer.Localization
@using GmailServer.Permissions
@using Microsoft.AspNetCore.Authorization
@using Volo.Abp.Users
@inject IPageLayout PageLayout
@inject ICurrentUser CurrentUser
@inject IHtmlLocalizer<GmailServerResource> L
@inject IAuthorizationService AuthorizationService
@{
    ViewBag.PageTitle = L["Apple ID None"];
    PageLayout.Content.Title = L["Apple ID None"].Value;
    PageLayout.Content.MenuItemName = GmailServerMenus.AppleIdNone;
}

@section scripts {
    <abp-script-bundle name="knockout" />
    <abp-script-bundle name="chosen" />
    <script>
        var appleIdNoneStatusSelections = @Html.Raw(ViewData["appleIdNoneStatusSelections"]);
        var removePaymentStatusSelections = @Html.Raw(ViewData["removePaymentStatusSelections"]);
        var usernameSelections = @Html.Raw(ViewData["usernameSelections"]);
    </script>
    <abp-script src="/Pages/AppleIdNones/js/index.js" />
    <abp-script src="/Pages/AppleIdNones/js/resetStatusViewModel.js" />
}
@section styles {
    <abp-style-bundle name="chosen" />
    <style>
        .modal-dialog {
            max-width: 800px;
        }

        .text-ellipsis {
            overflow: hidden;
            white-space: nowrap;
            display: inline-block;
            text-overflow: ellipsis;
            width: 400px;
        }

            .text-ellipsis.sm-width {
                width: 120px;
            }
    </style>
}

<abp-card>
    <abp-card-header>
        <abp-row>
            <abp-column size-md="_6">
                <h4>Apple ID None</h4>
            </abp-column>
            <abp-column size-md="_6">
                @if (await AuthorizationService.IsGrantedAsync(GmailServerPermissions.AppleIdNones.Create))
                {
                    <abp-button class="float-right btn btn-small btn-primary" id="createBtn" icon="plus" text="Create"></abp-button>
                }
                @if (await AuthorizationService.IsGrantedAsync(GmailServerPermissions.AppleIdNones.Delete))
                {
                    <abp-button class="float-right btn btn-small btn-danger" id="btnRemoveAll" icon="trash" text="Remove All" style="margin-right: 15px;"></abp-button>
                }
            </abp-column>
        </abp-row>
    </abp-card-header>
    <abp-card-body>
        <abp-table striped-rows="true" id="appleIdNoneTable" class="table-bordered">
            <thead>
                <tr>
                    <th>@L["ID"]</th>
                    <th>@L["Username"]</th>
                    <th>@L["Email"]</th>
                    <th>@L["Password"]</th>
                    <th>@L["Purchase"]</th>
                    <th>@L["Status"]</th>
                    <th>@L["AddPaymentCompleted"]</th>
                    <th>@L["Remove Payment Status"]</th>
                    <th>@L["Remove Taken Time"]</th>
                    <th>@L["Remove Update Time"]</th>
                    <th>@L["Taken Out Number"]</th>
                    <th>@L["Taken Time"]</th>
                    <th>@L["Created"]</th>
                    <th>@L["Action"]</th>
                </tr>
            </thead>
        </abp-table>
    </abp-card-body>
</abp-card>
