@page
@model GmailServer.Web.Pages.MomoAccounts.CreateManyModalModel
@using Microsoft.AspNetCore.Mvc.Localization
@using GmailServer.Localization
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@{
    Layout = null;
}
<abp-dynamic-form abp-model="MomoAccount" data-ajaxForm="true" asp-page="/MomoAccounts/CreateManyModal">
     <abp-modal>
        <abp-modal-header title="Create many account"></abp-modal-header>
        <abp-modal-body>
            <abp-form-content />
        </abp-modal-body>
        <abp-modal-footer buttons="@(AbpModalButtons.Cancel|AbpModalButtons.Save)"></abp-modal-footer>
    </abp-modal>
</abp-dynamic-form>
   