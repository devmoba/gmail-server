@page
@model GmailServer.Web.Pages.AppleIds.DownloadModel
@using GmailServer.Web.Menus
@using Volo.Abp.AspNetCore.Mvc.UI.Layout
@using Microsoft.AspNetCore.Mvc.Localization
@using GmailServer.Localization
@using GmailServer.Permissions
@using Microsoft.AspNetCore.Authorization
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@inject IPageLayout PageLayout
@inject IHtmlLocalizer<GmailServerResource> L
@inject IAuthorizationService AuthorizationService
@{
    ViewBag.PageTitle = L["Download Apple ID"];
    PageLayout.Content.Title = L["Download Apple ID"].Value;
}

@section scripts {
<script>
    var appleIdStatusSelections = @Html.Raw(ViewData["appleIdStatusSelections"]);
    var usernameSelections = @Html.Raw(ViewData["usernameSelections"]);
</script>
<abp-script-bundle name="knockout" />
<abp-script-bundle name="chosen" />
<abp-script src="/Pages/AppleIds/js/downloadViewModel.js" />
<script>
        var viewModel = new DownloadViewModel(usernameSelections, appleIdStatusSelections);
        ko.applyBindings(viewModel);
</script>
}

@section styles {
<abp-style-bundle name="chosen" />
<style>
    .col-md-6 label {
        margin-left: 5px;
    }
</style>
}

<abp-card>
    <abp-card-header>
        <abp-row>
            <abp-column size-md="_6">
                <h4>Download Apple ID</h4>
            </abp-column>
        </abp-row>
    </abp-card-header>
    <form id="downloadGmailForm" action="/AppleIds/Download" method="post" onSubmit="if(!confirm('Are you sure to download?')){return false;}">
        @(Html.AntiForgeryToken())
        <abp-card-body>
            <div class="row" style="padding-top: 15px;">
                <div class="col-md-2">
                    <label>Username (*)</label>
                </div>
                <div class="col-md-5">
                    <select asp-for="Username" class="form-control"
                            data-bind="options: usernames, optionsText: (i) => i.text, optionsValue: 'value', chosen: {}, value: selectedUsername"></select>
                </div>
            </div>
            <div class="row" style="padding-top: 15px;">
                <div class="col-md-2">
                    <label>Status</label>
                </div>
                <div class="col-md-5">
                    <div class="row" data-bind="foreach: { data: statuses, as: 'status' }">
                        <div class="col-md-6" style="padding-top: 15px;">
                            <label>
                                <input type="checkbox" name="Statuses" data-bind="value: status.value" style="transform: scale(1.8);" />
                                <span data-bind="text: status.text" style="font-size: 20px; margin-left: 15px;"></span>
                            </label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row" style="padding-top: 15px;">
                <div class="col-md-2">
                    <label>Created Date (*)</label>
                </div>
                <div class="col-md-4">
                    <div style="display: inline-flex;">
                        <label style="padding-top: 5px;">From</label>
                        <input id="createdFrom" type="date"
                               class="form-control"
                               asp-for="@Model.CreatedFrom"
                               style="margin-left: 15px;" />
                        <label style="padding: 5px 0px 0px 10px;">To</label>
                        <input id="createdTo" type="date"
                               class="form-control"
                               asp-for="@Model.CreatedTo"
                               style="margin-left: 15px;" />
                    </div>
                </div>
            </div>
            <div class="row" style="padding-top: 15px;">
                <div class="col-md-2">
                    <label>File name (*)</label>
                </div>
                <div class="col-md-5">
                    <input type="text" asp-for="FileName" class="form-control" />
                </div>
            </div>
        </abp-card-body>
        <abp-modal-footer buttons="@(AbpModalButtons.Cancel|AbpModalButtons.Save)"></abp-modal-footer>
    </form>
</abp-card>

