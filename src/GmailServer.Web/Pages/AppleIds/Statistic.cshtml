@page
@model GmailServer.Web.Pages.AppleIds.StatisticModel
@using GmailServer.Web.Menus
@using Volo.Abp.AspNetCore.Mvc.UI.Layout
@using Microsoft.AspNetCore.Mvc.Localization
@using GmailServer.Localization
@using GmailServer.Permissions
@using Microsoft.AspNetCore.Authorization
@inject IPageLayout PageLayout
@inject IHtmlLocalizer<GmailServerResource> L
@inject IAuthorizationService AuthorizationService
@{
    ViewBag.PageTitle = L["Apple ID Statistic"];
    PageLayout.Content.Title = L["Apple ID Statistic"].Value;
    PageLayout.Content.MenuItemName = GmailServerMenus.AppleIdStatistic;
}

@section scripts {
<abp-script-bundle name="knockout" />
<abp-script-bundle name="chosen" />
<abp-script-bundle name="canvasjs" />
<script>
    var usernameSelections = @Html.Raw(ViewData["usernameSelections"]);
</script>
<abp-script src="/Pages/AppleIds/js/statistic.js" />
}
@section styles {
<abp-style-bundle name="chosen" />
<style>
    #appleIdStatisticTable_wrapper .btn {
        padding: 5px 10px;
    }
    /*.modal-dialog {
        max-width: 800px;
    }

    .text-ellipsis {
        overflow: hidden;
        white-space: nowrap;
        display: inline-block;
        text-overflow: ellipsis;
        width: 450px;
    }*/
</style>
}

<abp-card>
    <abp-card-header>
        <abp-row>
            <abp-column size-md="_6">
                <h4>Apple ID Statistics</h4>
            </abp-column>
            <abp-column size-md="_6">
                
            </abp-column>
        </abp-row> 
        <abp-row>
            <abp-column size-md="_8">
                <div id="chartContainer" style="height: 550px; width: 100%;"></div>
            </abp-column>
        </abp-row>
    </abp-card-header>
    <abp-card-body>
        <abp-table striped-rows="true" id="appleIdStatisticTable" class="table-bordered">
            <thead>
                <tr>
                    <th>@L["#"]</th>
                    <th>@L["Username"]</th>
                    <th>@L["Total"]</th>
                    <th>@L["Total Purchase"]</th>
                    <th>@L["Ready"]</th>
                    <th>@L["Completed1"]</th>
                    <th>@L["Completed2"]</th>
                    <th>@L["Completed3"]</th>
                    <th>@L["Completed4"]</th>
                    <th>@L["Pending"]</th>
                    <th>@L["WrongPass"]</th>
                    <th>@L["Subed"]</th>
                    <th>@L["Locked1"]</th>
                    <th>@L["Locked2"]</th>
                    <th>@L["Review"]</th>
                    <th>@L["Error"]</th>
                    <th>@L["Unknown"]</th>
                    <th>@L["Action"]</th>
                </tr>
            </thead>
        </abp-table>
    </abp-card-body>
</abp-card>
