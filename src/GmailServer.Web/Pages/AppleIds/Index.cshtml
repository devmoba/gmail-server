@page
@model GmailServer.Web.Pages.AppleIds.IndexModel
@using GmailServer.Web.Menus
@using Volo.Abp.AspNetCore.Mvc.UI.Layout
@using Microsoft.AspNetCore.Mvc.Localization
@using GmailServer.Localization
@using GmailServer.Permissions
@using Microsoft.AspNetCore.Authorization
@inject IPageLayout PageLayout
@inject IHtmlLocalizer<GmailServerResource> L
@inject IAuthorizationService AuthorizationService
@{
    ViewBag.PageTitle = L["Apple ID"];
    PageLayout.Content.Title = L["Apple ID"].Value;
    PageLayout.Content.MenuItemName = GmailServerMenus.AppleId;
}

@section scripts {
<abp-script-bundle name="knockout" />
<abp-script-bundle name="chosen" />
<script>
    var appleIdStatusSelections = @Html.Raw(ViewData["appleIdStatusSelections"]);
    var usernameSelections = @Html.Raw(ViewData["usernameSelections"]);
    var isRoleNameAppleIdMember = @Html.Raw(ViewData["isRoleNameAppleIdMember"]);
</script>
<abp-script src="/Pages/AppleIds/js/index.js" />
}
@section styles {
<abp-style-bundle name="chosen" />
<style>
    .modal-dialog {
        max-width: 800px;
    }

    .text-ellipsis {
        overflow: hidden;
        white-space: nowrap;
        display: inline-block;
        text-overflow: ellipsis;
        width: 500px;
    }
</style>
}

<abp-card>
    <abp-card-header>
        <abp-row>
            <abp-column size-md="_6">
                <h4>Apple ID</h4>
            </abp-column>
            <abp-column size-md="_6">
                @if (await AuthorizationService.IsGrantedAsync(GmailServerPermissions.AppleIds.Create))
                {
                    <abp-button class="float-right btn btn-small btn-primary" id="createBtn" icon="plus" text="Create"></abp-button>
                }
                @if (await AuthorizationService.IsGrantedAsync(GmailServerPermissions.AppleIds.Delete))
                {
                    <abp-button class="float-right btn btn-small btn-primary" id="btnRemoveAll" icon="trash" text="Remove All" style="margin-right: 15px;"></abp-button>
                }
            </abp-column>
        </abp-row>
    </abp-card-header>
    <abp-card-body>
        <abp-table striped-rows="true" id="appleIdTable" class="table-bordered">
            <thead>
                <tr>
                    <th>@L["ID"]</th>
                    <th>@L["Username"]</th>
                    <th>@L["Email"]</th>
                    <th>@L["Password"]</th>
                    <th>@L["Status"]</th>
                    <th>@L["Taken Time"]</th>
                    <th>@L["Created"]</th>
                    <th>@L["Updated"]</th>
                    <th>@L["Action"]</th>
                </tr>
            </thead>
        </abp-table>
    </abp-card-body>
</abp-card>
