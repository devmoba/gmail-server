@page
@model GmailServer.Web.Pages.Gmails.DownloadModel
@using GmailServer.Web.Menus
@using Volo.Abp.AspNetCore.Mvc.UI.Layout
@using Microsoft.AspNetCore.Mvc.Localization
@using GmailServer.Localization
@using GmailServer.Permissions
@using Microsoft.AspNetCore.Authorization
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@inject IPageLayout PageLayout
@inject IHtmlLocalizer<GmailServerResource> L
@inject IAuthorizationService AuthorizationService
@{
    ViewBag.PageTitle = L["Download Gmail"];
    PageLayout.Content.Title = L["Download Gmail"].Value;
}

@section scripts {
<script>
    var gmailTypeSelections = @Html.Raw(ViewData["gmailTypeSelections"]);
</script>
<abp-script-bundle name="knockout" />
<abp-script-bundle name="chosen" />
<abp-script src="/Pages/Gmails/js/downloadFormViewModel.js" />
<abp-script src="/Pages/Gmails/js/download.js" />
}

@section styles {
<abp-style-bundle name="chosen" />
<style>
    #downloadGmailForm .row {
        margin-bottom: 20px;
    }
</style>
}


<abp-card>
    <abp-card-header>
        <abp-row>
            <abp-column size-md="_6">
                <h4>Download Gmail</h4>
            </abp-column>
        </abp-row>
    </abp-card-header>
    <form id="downloadGmailForm" action="/Gmails/Download" method="post" onSubmit="if(!confirm('Are you sure to download?')){return false;}">
        @(Html.AntiForgeryToken())
        <abp-card-body>
            <div class="row">
                <div class="col-md-6">
                    <!-- ko ifnot: checkedTimeRange -->
                    <div class="row">
                        <div class="col-md-12">
                            <label><input type="checkbox" style="transform: scale(1.8);" asp-for="@Model.CheckedAll" data-bind="checked: checkedAll" />&nbsp;&nbsp;&nbsp;All</label>
                        </div>
                    </div>
                    <!-- /ko -->
                    <!-- ko ifnot: checkedAll -->
                    <div class="row" style="padding-top: 15px;">
                        <div class="col-md-12">
                            <label><input type="checkbox" style="transform: scale(1.8);" asp-for="@Model.CheckedTimeRange" data-bind="checked: checkedTimeRange" />&nbsp;&nbsp;&nbsp;Time Range</label>
                        </div>
                    </div>
                    <div class="row" style="padding-top: 15px;">
                        <div class="col-md-4">
                            <div style="padding-left: 30px;display: inline-flex;">
                                <label style="padding-top: 5px;">From</label>
                                <input type="datetime"
                                       class="form-control"
                                       asp-for="@Model.DateFrom"
                                       value="@Model.DateFrom"
                                       style="margin-left: 15px;" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div style="padding-left: 30px;display: inline-flex;">
                                <label style="padding-top: 5px;">To</label>
                                <input type="datetime"
                                       class="form-control"
                                       asp-for="@Model.DateTo"
                                       value="@Model.DateTo"
                                       style="margin-left: 15px;" />
                            </div>
                        </div>
                    </div>
                    <!-- /ko -->
                     <div class="row">
                        <div class="col-md-12">
                            <label><input type="checkbox" style="transform: scale(1.8);" asp-for="@Model.CheckedGmailType" data-bind="checked: checkedGmailType" />&nbsp;&nbsp;&nbsp;Gmail Type</label>
                        </div>
                    </div>
                     <!-- ko if: checkedGmailType -->
                    <div class="row" style="padding-top: 15px;">
                        <div class="col-md-8">
                            <div style="padding-left: 30px;">
                                <select asp-for="@Model.GmailTypeId" asp-for="@Model.GmailTypeId" class="form-control"
                                        data-bind="options: gmailTypeSelections, optionsText: (i) => i.text, optionsValue: 'value', chosen: {}"></select>
                            </div>
                        </div>
                    </div>
                    <!-- /ko -->
                </div>
            </div>
        </abp-card-body>
        <abp-modal-footer buttons="@(AbpModalButtons.Cancel|AbpModalButtons.Save)"></abp-modal-footer>
    </form>
</abp-card>
